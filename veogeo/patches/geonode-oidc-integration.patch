diff --git a/geonode_mapstore_client/tests.py b/geonode_mapstore_client/tests.py
index db9778c82..690137741 100644
--- a/geonode_mapstore_client/tests.py
+++ b/geonode_mapstore_client/tests.py
@@ -309,0 +310,19 @@ class RequestConfigurationViewTestCase(GeoNodeBaseTestSupport):
+    @override_settings(
+        NOXT_GEOSERVER_CLOUD_ENABLED=True,
+        OGC_SERVER={"default": {"PUBLIC_LOCATION": "https://ogc.example.test/geoserver/"}},
+    )
+    def test_cloud_request_rules_leave_geo_server_auth_to_the_client(self):
+        """Cloud GeoNode APIs use session cookies; OGC Bearer auth is added client-side."""
+        from geonode_mapstore_client.handlers import BaseConfigurationRuleHandler
+        from geonode_mapstore_client.registry import RequestConfigurationRulesRegistry
+
+        RequestConfigurationRulesRegistry.REGISTRY = [BaseConfigurationRuleHandler]
+        self.client.force_authenticate(user=self.user)
+
+        response = self.client.get(reverse("request-rules"))
+
+        self.assertEqual(response.status_code, 200)
+        rules = response.json()["rules"]
+        self.assertEqual(rules, [])
+        self.assertFalse(any("Authorization" in rule.get("headers", {}) for rule in rules))
+
